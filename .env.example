# ENV is an optional legacy alias; if both are set they must match.
NODE_ENV=development
# Generate a random owner credential locally; store in .env/deployment secrets only.
# Required for startup; send as Authorization: Bearer through a trusted server client.
OWNER_API_TOKEN=
# Optional trusted frontend admission credential, identical to Vercel RATE_LIMIT_SECRET.
# Independent from OWNER_API_TOKEN. Leave unset to disable /api/admission safely.
# RATE_LIMIT_SECRET=<server-only random secret>
# Explicit listener bind. HOST is retired; wildcard bind preserves prior behavior.
BIND_HOST=0.0.0.0
PORT=3000
# Never point development/tests at production. Integration tests ignore these values.
CONNECTION_URL=mongodb://127.0.0.1:27017
TEST_DB_NAME=khanos_development
DB_NAME=khanos
GITHUB_API_URL=https://api.github.com/
GITHUB_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=50
# Unrelated routes retain the above per-client budget. URL budgets are separate.
URL_RATE_LIMIT_WINDOW_MS=60000
URL_RATE_LIMIT_ANONYMOUS_MAX=60
URL_RATE_LIMIT_RELAY_MAX=300
URL_RATE_LIMIT_OWNER_MAX=60
# Shared emergency ceiling across all non-health traffic in the URL window.
RATE_LIMIT_SAFETY_MAX=5000
# Rate limit storage. memory is only safe with exactly one process/replica.
RATE_LIMIT_STORE=memory
RATE_LIMIT_SINGLE_PROCESS=true
# Heroku production with multiple dynos requires RATE_LIMIT_STORE=redis.
# Heroku Key-Value Store automatically supplies REDIS_URL; do not copy its credentials.
# Required in redis mode; redis:// is also supported for local Redis.
# REDIS_URL=rediss://...
# TLS verifies certificates by default. Heroku KVS uses self-signed certificates:
# explicitly set false for that managed add-on only (TLS encryption remains enabled).
REDIS_TLS_REJECT_UNAUTHORIZED=true
RATE_LIMIT_STORE_TIMEOUT_MS=1000
# Same backend namespace on every replica; distinct from frontend and other apps.
RATE_LIMIT_PREFIX=khanos:backend:limits:v1
# Default cidr mode: empty CIDRs means forwarding headers are ignored.
# Heroku: set heroku ONLY with router-only ingress and rightmost XFF append verified.
# Heroku mode trusts exactly one hop and forbids simultaneous CIDR configuration.
RATE_LIMIT_PROXY_MODE=cidr
TRUSTED_PROXY_CIDRS=
SHUTDOWN_TIMEOUT_MS=10000
# TEST=true is only for app-factory tests; npm start rejects it.

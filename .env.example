# ENV is an optional legacy alias; if both are set they must match.
NODE_ENV=development
# Generate a random owner credential locally; store in .env/deployment secrets only.
# Required for startup; send as Authorization: Bearer through a trusted server client.
OWNER_API_TOKEN=
# Explicit listener bind. HOST is retired; wildcard bind preserves prior behavior.
BIND_HOST=0.0.0.0
PORT=3000
# Never point development/tests at production. Integration tests ignore these values.
CONNECTION_URL=mongodb://127.0.0.1:27017
TEST_DB_NAME=khanos_development
DB_NAME=khanos
GITHUB_API_URL=https://api.github.com/
GITHUB_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=50
SHUTDOWN_TIMEOUT_MS=10000
# TEST=true is only for app-factory tests; npm start rejects it.
